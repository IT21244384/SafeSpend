<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colours live in Compose (ui/theme/Color.kt). This XML theme only has to
         hand the activity a transparent, action-bar-free window to draw into. -->
    <style name="Theme.SafeSpend" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
